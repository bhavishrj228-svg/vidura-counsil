# Copy this file to ".env" and fill in real values.
# The app works without any of these -- evidence checks just fall back
# to heuristics and say so honestly in the UI.

# Optional: get a free key at https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
SAFE_BROWSING_API_KEY=

# Optional: starts Vidura's independent AI counsel as soon as a report is
# submitted. It reads the redacted message and current evidence, not votes.
# Get a key at https://console.anthropic.com. Without this, the report says
# honestly that an independent judgment could not be completed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Port the server listens on locally (most hosts override this automatically)
PORT=3000
