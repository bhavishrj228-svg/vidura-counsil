# Copy this file to ".env" and fill in real values.
# The app works without any of these -- evidence checks just fall back
# to heuristics and say so honestly in the UI.

# Optional: get a free key at https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
SAFE_BROWSING_API_KEY=

# Optional: powers the "Vidura's Judgment (AI-verified)" feature -- an
# actual AI model reads each reported message and gives an independent
# second opinion once enough people have voted. Get a key at
# https://console.anthropic.com. Without this, that section just shows
# an honest "not configured" message instead of pretending to check.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Port the server listens on locally (most hosts override this automatically)
PORT=3000
